  "components": {
    "schemas": {
      "CadastroRequest": {
        "required": [
          "ra",
          "email",
          "nomeDeExibicao",
          "prefixo",
          "senha"
        ],
        "type": "object",
        "properties": {
          "ra": {
            "maxLength": 32,
            "minLength": 0,
            "type": "string"
          },
          "email": {
            "maxLength": 254,
            "minLength": 0,
            "type": "string"
          },
          "nomeDeExibicao": {
            "maxLength": 240,
            "minLength": 0,
            "type": "string"
          },
          "prefixo": {
            "maxLength": 64,
            "minLength": 0,
            "type": "string"
          },
          "senha": {
            "maxLength": 512,
            "minLength": 0,
            "type": "string"
          }
        }
      },
      "DisponibilidadeRequest": {
        "required": [
          "ra",
          "email",
          "prefixo"
        ],
        "type": "object",
        "properties": {
          "ra": {
            "maxLength": 32,
            "minLength": 0,
            "type": "string"
          },
          "email": {
            "maxLength": 254,
            "minLength": 0,
            "type": "string"
          },
          "prefixo": {
            "maxLength": 64,
            "minLength": 0,
            "type": "string"
          }
        }
      },
      "DisponibilidadeResponse": {
        "required": [
          "disponivel"
        ],
        "type": "object",
        "properties": {
          "disponivel": {
            "type": "boolean"
          }
        }
      },
      "EuResponse": {
        "required": [
          "id",
          "papeis",
          "arroba"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "papeis": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "arroba": {
            "type": "string"
          }
        }
      },
      "HealthResponse": {
        "required": [
          "status"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "IdentificacaoRequest": {
        "required": [
          "ra",
          "email"
        ],
        "type": "object",
        "properties": {
          "ra": {
            "maxLength": 32,
            "minLength": 0,
            "type": "string"
          },
          "email": {
            "maxLength": 254,
            "minLength": 0,
            "type": "string"
          }
        }
      },
      "LoginRequest": {
        "required": [
          "identificador",
          "senha"
        ],
        "type": "object",
        "properties": {
          "identificador": {
            "maxLength": 254,
            "minLength": 0,
            "type": "string"
          },
          "senha": {
            "maxLength": 512,
            "minLength": 0,
            "type": "string"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "RefreshRequest": {
        "required": [
          "refreshToken"
        ],
        "type": "object",
        "properties": {
          "refreshToken": {
            "maxLength": 128,
            "minLength": 0,
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "SessaoResponse": {
        "required": [
          "accessToken",
          "accessTokenExpiraEm",
          "refreshToken",
          "refreshTokenExpiraEm"
        ],
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "accessTokenExpiraEm": {
            "type": "string",
            "format": "date-time"
          },
          "refreshToken": {
            "type": [
              "null",
              "string"
            ]
          },
          "refreshTokenExpiraEm": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SugestaoResponse": {
        "required": [
          "prefixo",
          "sufixo",
          "arroba"
        ],
        "type": "object",
        "properties": {
          "prefixo": {
            "type": "string"
          },
          "sufixo": {
            "type": "string"
          },
          "arroba": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "description": "Access token de 15 minutos.",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "tags": [
    {
      "name": "Health"
    },
    {
      "name": "Autenticacao"
    }
  ]
}