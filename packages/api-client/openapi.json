  "components": {
    "schemas": {
      "AlunoDaTurmaResponse": {
        "required": [
          "id",
          "nomeDeExibicao",
          "arroba",
          "medalhas"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "nomeDeExibicao": {
            "type": "string"
          },
          "arroba": {
            "type": "string"
          },
          "medalhas": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MedalhaNaTurmaResponse"
            }
          }
        }
      },
      "CadastroRequest": {
        "required": [
          "ra",
          "email",
          "nomeDeExibicao",
          "prefixo",
          "senha",
          "versaoDoTermo"
        ],
        "type": "object",
        "properties": {
          "ra": {
            "maxLength": 32,
            "minLength": 0,
            "type": "string"
          },
          "email": {
            "maxLength": 254,
            "minLength": 0,
            "type": "string"
          },
          "nomeDeExibicao": {
            "maxLength": 240,
            "minLength": 0,
            "type": "string"
          },
          "prefixo": {
            "maxLength": 64,
            "minLength": 0,
            "type": "string"
          },
          "senha": {
            "maxLength": 512,
            "minLength": 0,
            "type": "string"
          },
          "versaoDoTermo": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ConcessaoDeMedalhaRequest": {
        "required": [
          "alunoId",
          "item"
        ],
