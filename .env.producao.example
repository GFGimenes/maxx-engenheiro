# Nomes das variáveis do docker-compose.producao.yml. Só os nomes: os valores existem só no
# /opt/maxx/.env da VPS, escrito à mão e nunca versionado. Faltando qualquer uma, o compose
# recusa subir. Ficam de fora de propósito: COMPOSE_PROFILES (sem emulador do bucket) e
# MAXX_ARMAZENAMENTO_ENDPOINT_PUBLICO (no R2, o público é o próprio endpoint).

# Tag das imagens no GHCR: sha-<curto> de uma publicação, ou latest (só da main).
MAXX_IMAGEM_TAG=

POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Chave HS256 do access token, base64 de ao menos 32 bytes (openssl rand -base64 48).
MAXX_JWT_CHAVE=

# https://app.maxx-unimax.com: link do e-mail de recuperação e endereço do site no Caddy,
# que com https:// emite o certificado sozinho.
MAXX_URL_PUBLICA=

# SMTP de produção, usado só pelo worker.
MAXX_EMAIL_REMETENTE=
MAXX_SMTP_HOST=
MAXX_SMTP_PORTA=
MAXX_SMTP_SEGURANCA=
MAXX_SMTP_USUARIO=
MAXX_SMTP_SENHA=

# Lote da avaliação. Só vale com o docker-compose.demo.yml por cima.
MAXX_DEMO_LOTE=

# Cloudflare R2: endpoint https://<conta>.r2.cloudflarestorage.com, região auto, token
# restrito ao bucket, leitura pelo domínio da CDN (https://fotos.maxx-unimax.com).
MAXX_ARMAZENAMENTO_BUCKET=
MAXX_ARMAZENAMENTO_ENDPOINT=
MAXX_ARMAZENAMENTO_URL_DE_LEITURA=
MAXX_ARMAZENAMENTO_REGIAO=
MAXX_ARMAZENAMENTO_CHAVE_DE_ACESSO=
MAXX_ARMAZENAMENTO_SEGREDO=
